# Copy this file to .env (for `netlify dev` locally) and fill in your own
# values. Never commit the real .env file or paste these values in chat.

# Required: your Resend API key (resend.com dashboard -> API Keys).
RESEND_API_KEY=

# Optional: sender address once a domain is verified in Resend, e.g.
# "Art of Engineering <enquiries@artofengineering.in>". Until then the
# function falls back to Resend's shared test sender.
RESEND_FROM=
