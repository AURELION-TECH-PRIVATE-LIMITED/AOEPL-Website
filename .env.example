# Copy this file to .env (for `netlify dev` locally) and fill in your own
# values. Never commit the real .env file or paste these values in chat.

# Required: your Resend API key (resend.com dashboard -> API Keys).
RESEND_API_KEY=

# Optional: only needed if you want to override the sender. Defaults to
# "Art of Engineering <enquiries@artofengineering.in>" (already verified
# in Resend) if left blank.
RESEND_FROM=
